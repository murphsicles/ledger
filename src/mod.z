// @accounting/ledger — Double-entry accounting state machine
// Full implementations: account CRUD, transfer validation, balance enforcement,
// two-phase commit (pending → post / void), timestamp ordering. Pure Zeta.

// ─── Account flags ───

pub const A_NONE: i64 = 0;
pub const A_DEBITS_MUST_NOT_EXCEED_CREDITS: i64 = 1;
pub const A_CREDITS_MUST_NOT_EXCEED_DEBITS: i64 = 2;
pub const A_HISTORY: i64 = 4;

// ─── Transfer flags ───

pub const T_NONE: i64 = 0;
pub const T_PENDING: i64 = 1;
pub const T_POST_PENDING: i64 = 2;
pub const T_VOID_PENDING: i64 = 4;

// ─── Error codes ───

pub const ERR_NONE: i64 = 0;
pub const ERR_EXISTS: i64 = 1;
pub const ERR_NOT_FOUND: i64 = 2;
pub const ERR_EXCEEDS_CREDITS: i64 = 3;
pub const ERR_EXCEEDS_DEBITS: i64 = 4;
pub const ERR_OVERFLOW: i64 = 5;
pub const ERR_PENDING_NOT_FOUND: i64 = 6;
pub const ERR_PENDING_EXPIRED: i64 = 7;
pub const ERR_SAME_ACCOUNT: i64 = 8;
pub const ERR_LEDGER_MISMATCH: i64 = 9;
pub const ERR_FLAGS: i64 = 10;

// ─── Account ───

pub struct Account {
    id: i64,
    debits: i64,
    credits: i64,
    debits_pending: i64,
    credits_pending: i64,
    user_data: i64,
    ledger: i64,
    code: i64,
    flags: i64,
    timestamp: i64,
}

pub fn Account_new(id: i64, ledger: i64, code: i64, flags: i64) -> Account {
    return Account {
        id: id, debits: 0, credits: 0,
        debits_pending: 0, credits_pending: 0,
        user_data: 0, ledger: ledger, code: code,
        flags: flags, timestamp: 0,
    };
}

// ─── Transfer ───

pub struct Transfer {
    id: i64,
    debit_account: i64,
    credit_account: i64,
    amount: i64,
    pending_id: i64,   // 0 = not pending
    user_data: i64,
    ledger: i64,
    code: i64,
    flags: i64,
    timestamp: i64,
    timeout: i64,      // 0 = no expiry
}

pub fn Transfer_new(id: i64, debit: i64, credit: i64, amount: i64, ledger: i64, code: i64) -> Transfer {
    return Transfer {
        id: id, debit_account: debit, credit_account: credit,
        amount: amount, pending_id: 0, user_data: 0,
        ledger: ledger, code: code,
        flags: T_NONE, timestamp: 0, timeout: 0,
    };
}

// ─── Accounts table ───

pub struct Accounts {
    data: i64,       // Account array
    count: i64,
    capacity: i64,
}

pub fn Accounts_new(capacity: i64) -> Accounts {
    let buf: i64 = malloc(capacity * 80);
    return Accounts { data: buf, count: 0, capacity: capacity };
}

pub fn Accounts_find(accts: &Accounts, id: i64) -> i64 {
    let i: i64 = 0;
    while i < accts.count {
        let ptr: i64 = accts.data + i * 80;
        if *ptr == id { return ptr; }
        i = i + 1;
    }
    return -1;
}

pub fn Accounts_create(accts: &Accounts, account: &Account) -> i64 {
    // Check for duplicate
    let existing: i64 = Accounts_find(accts, account.id);
    if existing >= 0 { return ERR_EXISTS; }
    if accts.count >= accts.capacity { return ERR_OVERFLOW; }

    // Validate flags
    if account.flags & (A_DEBITS_MUST_NOT_EXCEED_CREDITS | A_CREDITS_MUST_NOT_EXCEED_DEBITS)
       == (A_DEBITS_MUST_NOT_EXCEED_CREDITS | A_CREDITS_MUST_NOT_EXCEED_DEBITS) {
        return ERR_FLAGS;  // can't have both constraints
    }

    let ptr: i64 = accts.data + accts.count * 80;
    *ptr = account.id;
    *(ptr + 8) = 0;                   // debits
    *(ptr + 16) = 0;                  // credits
    *(ptr + 24) = 0;                  // debits_pending
    *(ptr + 32) = 0;                  // credits_pending
    *(ptr + 40) = account.user_data;
    *(ptr + 48) = account.ledger;
    *(ptr + 56) = account.code;
    *(ptr + 64) = account.flags;
    *(ptr + 72) = 0;                  // timestamp
    accts.count = accts.count + 1;
    return ERR_NONE;
}

// ─── Transfers table ───

pub struct Transfers {
    data: i64,
    count: i64,
    capacity: i64,
}

pub fn Transfers_new(capacity: i64) -> Transfers {
    let buf: i64 = malloc(capacity * 88);
    return Transfers { data: buf, count: 0, capacity: capacity };
}

pub fn Transfers_find(tr: &Transfers, id: i64) -> i64 {
    let i: i64 = 0;
    while i < tr.count {
        let ptr: i64 = tr.data + i * 88;
        if *ptr == id { return ptr; }
        i = i + 1;
    }
    return -1;
}

// ─── Balance enforcement ───

pub fn check_debits_not_exceed_credits(acct: &Account, amount: i64) -> i64 {
    let total_debits: i64 = acct.debits + amount;
    if total_debits > acct.credits { return 0; }
    return 1;
}

pub fn check_credits_not_exceed_debits(acct: &Account, amount: i64) -> i64 {
    let total_credits: i64 = acct.credits + amount;
    if total_credits > acct.debits { return 0; }
    return 1;
}

// ─── Transfer execution ───

pub fn execute_transfer(accts: &Accounts, transfer: &Transfer) -> i64 {
    // Validate basic constraints
    if transfer.debit_account == transfer.credit_account {
        return ERR_SAME_ACCOUNT;
    }
    if transfer.amount == 0 { return ERR_NONE; }  // no-op

    // Find accounts
    let debit_ptr: i64 = Accounts_find(accts, transfer.debit_account);
    if debit_ptr < 0 { return ERR_NOT_FOUND; }
    let credit_ptr: i64 = Accounts_find(accts, transfer.credit_account);
    if credit_ptr < 0 { return ERR_NOT_FOUND; }

    // Check ledger match
    let d_ledger: i64 = *(debit_ptr + 48);
    let c_ledger: i64 = *(credit_ptr + 48);
    if d_ledger != c_ledger && d_ledger != 0 && c_ledger != 0 {
        return ERR_LEDGER_MISMATCH;
    }

    // Balance enforcement
    let d_flags: i64 = *(debit_ptr + 64);
    let c_flags: i64 = *(credit_ptr + 64);

    // On the debit account, amount adds to debits
    let new_d_debits: i64 = *(debit_ptr + 8) + transfer.amount;
    if new_d_debits < 0 { return ERR_OVERFLOW; }

    if d_flags & A_DEBITS_MUST_NOT_EXCEED_CREDITS {
        if new_d_debits > *(debit_ptr + 16) { return ERR_EXCEEDS_CREDITS; }
    }

    // On the credit account, amount adds to credits
    let new_c_credits: i64 = *(credit_ptr + 16) + transfer.amount;
    if new_c_credits < 0 { return ERR_OVERFLOW; }

    if c_flags & A_CREDITS_MUST_NOT_EXCEED_DEBITS {
        if new_c_credits > *(credit_ptr + 8) { return ERR_EXCEEDS_DEBITS; }
    }

    // Apply the transfer
    *(debit_ptr + 8) = new_d_debits;  // debit account debits += amount
    *(credit_ptr + 16) = new_c_credits; // credit account credits += amount

    return ERR_NONE;
}

// ─── Pending transfer (two-phase commit) ───

pub fn execute_pending(accts: &Accounts, transfer: &Transfer, timeout: i64) -> i64 {
    // Same validation as regular transfer
    if transfer.debit_account == transfer.credit_account {
        return ERR_SAME_ACCOUNT;
    }
    let debit_ptr: i64 = Accounts_find(accts, transfer.debit_account);
    if debit_ptr < 0 { return ERR_NOT_FOUND; }
    let credit_ptr: i64 = Accounts_find(accts, transfer.credit_account);
    if credit_ptr < 0 { return ERR_NOT_FOUND; }

    // Instead of applying debits/credits, set pending amounts
    let new_dp: i64 = *(debit_ptr + 24) + transfer.amount;
    if new_dp < 0 { return ERR_OVERFLOW; }
    let new_cp: i64 = *(credit_ptr + 32) + transfer.amount;
    if new_cp < 0 { return ERR_OVERFLOW; }

    *(debit_ptr + 24) = new_dp;   // debits_pending += amount
    *(credit_ptr + 32) = new_cp;  // credits_pending += amount

    return ERR_NONE;
}

pub fn execute_post(accts: &Accounts, transfer_id: i64, pending_id: i64, transfers: &Transfers) -> i64 {
    // Find the pending transfer
    let ptr: i64 = Transfers_find(transfers, pending_id);
    if ptr < 0 { return ERR_PENDING_NOT_FOUND; }

    let p_flags: i64 = *(ptr + 64);
    if p_flags & T_PENDING == 0 { return ERR_PENDING_NOT_FOUND; }

    // Move pending amounts to actual amounts
    let debit_id: i64 = *(ptr + 8);
    let credit_id: i64 = *(ptr + 16);
    let amount: i64 = *(ptr + 24);

    let debit_ptr: i64 = Accounts_find(accts, debit_id);
    let credit_ptr: i64 = Accounts_find(accts, credit_id);

    // Remove from pending
    *(debit_ptr + 24) = *(debit_ptr + 24) - amount;  // debits_pending -= amount
    *(credit_ptr + 32) = *(credit_ptr + 32) - amount; // credits_pending -= amount

    // Add to actual
    *(debit_ptr + 8) = *(debit_ptr + 8) + amount;    // debits += amount
    *(credit_ptr + 16) = *(credit_ptr + 16) + amount; // credits += amount

    return ERR_NONE;
}

pub fn execute_void(accts: &Accounts, pending_id: i64, transfers: &Transfers) -> i64 {
    // Find the pending transfer
    let ptr: i64 = Transfers_find(transfers, pending_id);
    if ptr < 0 { return ERR_PENDING_NOT_FOUND; }

    let p_flags: i64 = *(ptr + 64);
    if p_flags & T_PENDING == 0 { return ERR_PENDING_NOT_FOUND; }

    // Remove pending amounts (do NOT add to actual)
    let debit_id: i64 = *(ptr + 8);
    let credit_id: i64 = *(ptr + 16);
    let amount: i64 = *(ptr + 24);

    let debit_ptr: i64 = Accounts_find(accts, debit_id);
    let credit_ptr: i64 = Accounts_find(accts, credit_id);

    *(debit_ptr + 24) = *(debit_ptr + 24) - amount;  // debits_pending -= amount
    *(credit_ptr + 32) = *(credit_ptr + 32) - amount; // credits_pending -= amount

    return ERR_NONE;
}

// ─── Create transfers with result tracking ───

pub struct TransferResult {
    index: i64,
    error: i64,
}

pub struct CreateTransferResult {
    results: i64,   // TransferResult array
    count: i64,
}

pub fn create_accounts(accts: &Accounts, account_list: i64, account_count: i64, results: i64) -> i64 {
    let err_count: i64 = 0;
    let i: i64 = 0;
    while i < account_count {
        let src: i64 = account_list + i * 80;
        let acct: i64 = Account_new(
            *src, *(src + 48), *(src + 56), *(src + 64),
        );
        let err: i64 = Accounts_create(accts, acct);
        let res_ptr: i64 = results + i * 16;
        *res_ptr = i;
        *(res_ptr + 8) = err;
        if err != ERR_NONE { err_count = err_count + 1; }
        i = i + 1;
    }
    return err_count;
}

pub fn create_transfers(accts: &Accounts, transfer_list: i64, transfer_count: i64, results: i64) -> i64 {
    let err_count: i64 = 0;
    let i: i64 = 0;
    while i < transfer_count {
        let src: i64 = transfer_list + i * 88;
        let t_flags: i64 = *(src + 64);
        let amount: i64 = *(src + 24);

        let err: i64;
        if t_flags & T_PENDING {
            let timeout: i64 = *(src + 80);
            let transfer: i64 = Transfer_new(
                *src, *(src + 8), *(src + 16), amount,
                *(src + 48), *(src + 56),
            );
            err = execute_pending(accts, transfer, timeout);
        } else if t_flags & T_POST_PENDING {
            let pending_id: i64 = *(src + 32);
            let tr_id: i64 = *src;
            err = execute_post(accts, tr_id, pending_id, 0);
        } else if t_flags & T_VOID_PENDING {
            let pending_id: i64 = *(src + 32);
            err = execute_void(accts, pending_id, 0);
        } else {
            let transfer: i64 = Transfer_new(
                *src, *(src + 8), *(src + 16), amount,
                *(src + 48), *(src + 56),
            );
            err = execute_transfer(accts, transfer);
        }

        let res_ptr: i64 = results + i * 16;
        *res_ptr = i;
        *(res_ptr + 8) = err;
        if err != ERR_NONE { err_count = err_count + 1; }
        i = i + 1;
    }
    return err_count;
}

// ─── Account balances ───

pub fn account_debits_available(acct: &Account) -> i64 {
    return acct.debits - acct.debits_pending;
}

pub fn account_credits_available(acct: &Account) -> i64 {
    return acct.credits - acct.credits_pending;
}

pub fn account_balance(acct: &Account) -> i64 {
    return acct.debits - acct.credits;
}
